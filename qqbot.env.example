# 把这些变量设置到启动 NoneBot 的环境中。
# 原始源码里的密钥已经暴露，请先全部轮换，再填入新密钥。
DEEPSEEK_API_KEY=
VISION_API_KEY=
BOCHA_API_KEY=
BRAVE_IMAGE_API_KEY=
ONEBOT_ACCESS_TOKEN=
IMAGE_RERANK_ENABLED=1
EMOJI_LIBRARY_PATH=emoji_library.json
EMOJI_ASSET_DIR=emoji_assets
HUMOR_MEMORY_PATH=humor_memory.json
PROACTIVE_EMOJI_ENABLED=1
PROACTIVE_EMOJI_RATE=0.18
EMOJI_COOLDOWN_SECONDS=120

# 可选覆盖项
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
VISION_BASE_URL=https://maas.qianwenaiapi.com/compatible-mode/v1
BOCHA_SEARCH_URL=https://api.bochaai.com/v1/web-search
BRAVE_IMAGE_SEARCH_URL=https://api.search.brave.com/res/v1/images/search
